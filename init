#!/bin/bash
set -e

ProjectName="BEERUS Framework"
isRootLess=false
rootPath=""

IP="127.0.0.1"
PORT="2222"
COMMAND=""

usage() {
    cat <<USAGE
Usage: $0 <command> [options]

Commands:
  build           Build .deb package only
  install         Install existing .deb on device (requires --ip)
  deploy          Build + install in one step
  clean           Remove build artifacts

Options:
  --ip <addr>     Device IP address          (default: $IP)
  --port <port>   SSH port                   (default: $PORT)
  --rootless      Build for rootless jailbreak (palera1n/dopamine)
  -h, --help      Show this help

Examples:
  $0 build
  $0 deploy --ip 192.168.1.50 --port 22
  $0 install --ip 192.168.1.50 --rootless
  $0 deploy  # uses default IP=$IP PORT=$PORT
USAGE
    exit 0
}

# --- Parse arguments ---
while [[ $# -gt 0 ]]; do
    case "$1" in
        build|install|deploy|clean)
            COMMAND="$1"; shift ;;
        --ip)
            IP="$2"; shift 2 ;;
        --port)
            PORT="$2"; shift 2 ;;
        --rootless)
            isRootLess=true; shift ;;
        -h|--help)
            usage ;;
        *)
            echo "Unknown argument: $1"
            usage ;;
    esac
done

if [ -z "$COMMAND" ]; then
    echo "Error: no command specified."
    echo ""
    usage
fi

setup() {
    if [ "$isRootLess" = true ]; then
        rootPath="/var/jb"
    fi
}

compileDaemon() {
    SDK="$(xcrun --sdk iphoneos --show-sdk-path)"

    clang -arch arm64 \
    -isysroot "$SDK" \
    -miphoneos-version-min=14.0 \
    -O2 -Wall \
    -framework CoreFoundation \
    Daemon/BeerusDaemon.c Daemon/BeerusInjector.c \
    -lproc -lz \
    -o Daemon/beerusd

    ldid -SDaemon/daemon-ent.plist Daemon/beerusd
}

newEntFile() {
cat <<EOF > ent.plist
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.private.security.no-container</key>
	<true/>
	<key>platform-application</key>
	<true/>
	<key>keychain-access-groups</key>
	<array>
		<string>io.hakaisecurity.beerus-framework</string>
	</array>
	<key>com.apple.private.security.setuid</key>
	<true/>
	<key>com.apple.private.security.no-sandbox</key>
	<true/>
	<key>proc_info-allow</key>
	<true/>
	<key>com.apple.private.security.storage.AppBundles</key>
	<true/>
	<key>com.apple.private.security.storage.AppDataContainers</key>
	<true/>
	<key>com.apple.security.iokit-user-client-class</key>
	<array>
		<string>AGXDeviceUserClient</string>
		<string>IOHDIXControllerUserClient</string>
		<string>IOSurfaceRootUserClient</string>
	</array>
	<key>com.apple.private.persona-mgmt</key>
	<true/>
	<key>com.apple.security.exception.shared-preference.read-write</key>
	<array>
		<string>io.hakaisecurity.beerus</string>
	</array>
	<key>com.apple.security.exception.files.absolute-path.read-write</key>
	<array>
		<string>/</string>
	</array>
	<key>com.apple.private.MobileContainerManager.allowed</key>
	<true/>
	<key>com.apple.springboard.launchapplications</key>
	<true/>
	<key>com.apple.backboardd.launchapplications</key>
	<true/>
	<key>com.apple.lsapplicationworkspace.rebuildappdatabases</key>
	<true/>
</dict>
</plist>
EOF
}

build() {
    if [ "$isRootLess" = false ]; then
        echo "AVISO: build ROOTFUL (/Applications, /Library, /usr/local/bin)."
        echo "A maioria dos jailbreaks modernos (palera1n, Dopamine) e ROOTLESS -- use --rootless."
        read -r -p "Continuar mesmo assim com ROOTFUL? [y/N] " confirm
        case "$confirm" in
            [yY][eE][sS]|[yY]) ;;
            *) echo "Abortado. Rode de novo com --rootless."; exit 1 ;;
        esac
    fi

    if [ -f "$ProjectName.deb" ]; then
        rm "$ProjectName.deb"
    fi

    xcodebuild \
    -project "$ProjectName.xcodeproj" \
    -scheme "$ProjectName" \
    -configuration Release \
    -sdk iphoneos \
    -derivedDataPath ./build \
    CODE_SIGNING_ALLOWED=NO

    mkdir -p .tmp/
    mv "build/Build/Products/Release-iphoneos/$ProjectName.app" ".tmp/"
    rm -rf ./build

    cd .tmp/; 
    
    newEntFile
    ldid -S"ent.plist" "$ProjectName.app"
    cd ../



    mkdir -p .deb/DEBIAN
    mkdir -p .deb$rootPath/Applications/
    mkdir -p .deb$rootPath/Library/LaunchDaemons
    mkdir -p .deb$rootPath/usr/local/bin

    mv ".tmp/$ProjectName.app" ".deb$rootPath/Applications/"
    rm -rf .tmp/

    PKG_VERSION=$(xcodebuild -showBuildSettings -project "$ProjectName.xcodeproj" -scheme "$ProjectName" -configuration Release 2>/dev/null | awk -F' = ' '/ MARKETING_VERSION /{print $2; exit}')
    BUILD_NUM=$(xcodebuild -showBuildSettings -project "$ProjectName.xcodeproj" -scheme "$ProjectName" -configuration Release 2>/dev/null | awk -F' = ' '/ CURRENT_PROJECT_VERSION /{print $2; exit}')
    [ -z "$PKG_VERSION" ] && PKG_VERSION="1.0.0"
    [ -n "$BUILD_NUM" ] && PKG_VERSION="${PKG_VERSION}-${BUILD_NUM}"

    cat <<EOF > .deb/DEBIAN/control
Package: io.hakaisecurity.beerus-framework
Name: Beerus Framework
Version: $PKG_VERSION
Architecture: all
Depends: uikittools
Description: iOS security testing framework
Maintainer: Hakai Security
Author: Hakai Security
Section: Applications
EOF

    cat <<EOF > .deb/DEBIAN/postinst
#!/bin/sh

chown root:wheel "$rootPath/Applications/$ProjectName.app/$ProjectName" || true
chmod 6755 "$rootPath/Applications/$ProjectName.app/$ProjectName" || true
uicache -p "$rootPath/Applications/$ProjectName.app" || true

chown root:wheel "$rootPath/usr/local/bin/beerusd" || true
chmod 755 "$rootPath/usr/local/bin/beerusd" || true
chown root:wheel "$rootPath/Library/LaunchDaemons/com.beerus.daemon.plist" || true
chmod 644 "$rootPath/Library/LaunchDaemons/com.beerus.daemon.plist" || true

# Stop old daemon if upgrading
launchctl bootout system "$rootPath/Library/LaunchDaemons/com.beerus.daemon.plist" 2>/dev/null || true
# Also stop legacy daemon if present
launchctl bootout system "$rootPath/Library/LaunchDaemons/io.hakaisecurity.BEERUS-Framework.plist" 2>/dev/null || true
rm -f "$rootPath/Library/LaunchDaemons/io.hakaisecurity.BEERUS-Framework.plist" 2>/dev/null || true
rm -f "$rootPath/usr/local/bin/BEERUS-Framework" 2>/dev/null || true

launchctl bootstrap system "$rootPath/Library/LaunchDaemons/com.beerus.daemon.plist" || true

exit 0
EOF



    cat <<EOF > .deb/DEBIAN/postrm
#!/bin/sh
set -e

case "\$1" in
  remove|purge)
    if command -v launchctl >/dev/null 2>&1; then
      launchctl bootout system "$rootPath/Library/LaunchDaemons/com.beerus.daemon.plist" 2>/dev/null || true
    fi

    killall beerusd 2>/dev/null || true
    rm -f /var/run/beerus.sock 2>/dev/null || true
    rm -f "$rootPath/usr/local/bin/beerusd" 2>/dev/null || true

    if command -v uicache >/dev/null 2>&1; then
      uicache -a 2>/dev/null || true
    fi
  ;;
esac

exit 0
EOF


    cat <<EOF > .deb/DEBIAN/prerm
#!/bin/sh
set -e

case "\$1" in
  remove|upgrade|deconfigure)
    launchctl bootout system "$rootPath/Library/LaunchDaemons/com.beerus.daemon.plist" 2>/dev/null || true
    killall beerusd 2>/dev/null || true
  ;;
esac

exit 0

EOF


    chmod 0775 .deb/DEBIAN/postinst
    chmod 0755 .deb/DEBIAN/postrm
    chmod 0755 .deb/DEBIAN/prerm
    
    cat <<EOF > .deb$rootPath/Library/LaunchDaemons/com.beerus.daemon.plist
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.beerus.daemon</string>

  <key>ProgramArguments</key>
  <array>
    <string>$rootPath/usr/local/bin/beerusd</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>UserName</key>
  <string>root</string>
</dict>
</plist>
EOF
    
    compileDaemon
    mv Daemon/beerusd ".deb$rootPath/usr/local/bin/beerusd"

    dpkg-deb -b .deb "$ProjectName.deb"
    rm -rf .deb

    echo ""
    echo "Package built: $ProjectName.deb"
}

install_deb() {
    local deb="$ProjectName.deb"

    if [ ! -f "$deb" ]; then
        echo "Error: $deb not found. Run '$0 build' first."
        exit 1
    fi

    echo ""
    echo "Installing on $IP:$PORT ..."

    scp -P "$PORT" "$deb" "root@$IP:/var/root/"
    ssh -p "$PORT" "root@$IP" "dpkg -r io.hakaisecurity.beerus-framework 2>/dev/null || true"
    ssh -p "$PORT" "root@$IP" "dpkg -i /var/root/$(printf '%s' "$deb" | sed 's/ /\\ /g')"

    echo "Installed on device"
    rm -rf $deb
}

do_clean() {
    rm -rf .deb .tmp build "$ProjectName.deb"
    echo "Cleaned"
}

# --- Main ---
setup

case "$COMMAND" in
    build)
        build
        ;;
    install)
        install_deb
        ;;
    deploy)
        build
        install_deb
        ;;
    clean)
        do_clean
        ;;
esac